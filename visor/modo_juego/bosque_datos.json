{
 "fuente": "SILENT HILL 4.exe (GOG) solo lectura + datos/escenas.json. tools/bosque/bosque_datos.py",
 "como_se_lee": {
  "fin": "evnum -> banderas que prende (+n) o apaga (-n) al terminar (tablas 0x620B50[etapa] y 0x620B80)",
  "guiones": "comandos como mundos_datos.json (msg/archivo/si_no/item/llamada); archivo 0 = message_common, 4 = room0, 6 = forest0",
  "agujeros": "tabla 0x618580: al meterse en el agujero de (etapa, escena) se prenden bandera y bandera2 (y se apagan las de las otras filas); al volver por el del 302 se va a la primera fila con la bandera prendida, a pos/rot",
  "zonas": "escena/mitad -> objetos atados a una puerta (dmy1 6, dmy2 = door_no) o que piden usar un ítem (dmy6 1/2, dmy13 = ítem)",
  "cerraduras": "Filas de 8 u32 {door, tipo, a8, aC, a10, a14, a18, a1c} hasta door = -1. Por tipo:\n  0: bandera a8; del lado de la escena aC se destraba (guion a10); del otro, cerrada (guion a14)   (0x4fd990)\n  1/2: bandera a8; en la escena aC con el ítem a1c se usa (guion a18), sin él guion a10; del otro lado a14 (0x4fda80)\n  3/4: siempre cerrada, guion a8 (0x4fdc10 / 0x4fdc60)\n  5: hasta tres condiciones (bandera, estado): a8/aC, a10/a14, a18/a1c; si no se cumplen no responde (0x4fdcb0)\n  6: abierta con la bandera a8; si no, guion aC (0x4fdd50)"
 },
